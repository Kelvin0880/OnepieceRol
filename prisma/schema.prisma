// Prisma schema — Grand Line RPG
// Dev uses SQLite (zero-config, file-based). Swap provider to "postgresql"
// and DATABASE_URL to a Supabase/Neon connection string for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Accounts ----------

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  characters   Character[]
}

// ---------- Characters ----------

enum Faction {
  PIRATE
  MARINE
  REVOLUTIONARY
  BOUNTY_HUNTER
  CP0
}

enum CharacterStatus {
  ALIVE
  DEAD
  RETIRED
  IMPRISONED
}

model Character {
  id      String          @id @default(cuid())
  name    String
  faction Faction
  status  CharacterStatus @default(ALIVE)
  userId  String
  user    User            @relation(fields: [userId], references: [id])

  // Core stats — raw points, each roughly 1-99 in the early game
  strength   Int @default(5)
  agility    Int @default(5)
  durability Int @default(5)
  willpower  Int @default(5) // fuels Haki growth
  intellect  Int @default(5) // fuels devil fruit mastery / negotiation checks

  level      Int @default(1)
  experience Int @default(0)

  hp    Int @default(50)
  maxHp Int @default(50)

  berries Int @default(3000) // starting money, canon-flavored amount

  bounty     Int     @default(0) // pirates
  marineRank String? // marines: "Recluta", "Alférez", ... escalates with merit
  notoriety  Int     @default(0) // revolutionaries/bounty hunters track this instead of bounty

  observationHaki Int     @default(0) // 0-100, 0 = locked
  armamentHaki    Int     @default(0)
  conquerorsHaki  Boolean @default(false) // exceedingly rare, rolled for, not chosen

  devilFruitId String?     @unique
  devilFruit   DevilFruit? @relation(fields: [devilFruitId], references: [id])

  equippedWeaponId String? @unique
  equippedWeapon   Weapon? @relation("EquippedWeapon", fields: [equippedWeaponId], references: [id])

  currentIslandId String
  currentIsland   Island @relation(fields: [currentIslandId], references: [id])

  crewId    String?
  crew      Crew?   @relation(fields: [crewId], references: [id])
  isCaptain Boolean @default(false)

  inventory            InventoryItem[]
  ownedWeapons         Weapon[]                 @relation("OwnedWeapons")
  companions           NPCCompanion[]
  logs                 GameLogEntry[]
  bountyLogs           BountyLogEntry[]
  sceneMessages        SceneMessage[]
  battleParticipations GroupBattleParticipant[]

  poneglyphsRead String @default("[]") // JSON string array of Poneglyph ids read
  // How actively hunted this character is for what they know — Poneglyphs
  // are stone, not loot; nobody steals them back, they silence the reader.
  // Spikes hard on each new Poneglyph, decays slowly with time.
  poneglyphHeat  Int    @default(0)
  islandsVisited String @default("[]") // JSON string array of Island ids — gates the once-per-island arc-hook intro

  lastTrainedAt DateTime? // null = never trained under this rule yet, so always eligible

  // Stamina (see engine/stamina.ts): spent by techniques, regenerated lazily
  // from staminaUpdatedAt on read — null reads as "fully rested since now".
  stamina          Int       @default(100)
  maxStamina       Int       @default(100)
  staminaUpdatedAt DateTime?

  // Travel is a decision, not a free hop: cooldown scaled by the destination's
  // danger (engine/travel.ts). null = never traveled, always eligible.
  lastTravelAt DateTime?

  // Refreshed by the character poll (throttled) — real PvP hunts only land on
  // people who are actually online (engine/hostility.ts).
  lastSeenAt DateTime?

  // Silent context compaction (game/scene-compaction.ts): scene messages up to
  // this instant have already been folded into memorySummary.
  sceneCompactedUntil DateTime?

  // Devil fruit progression (see engine/fruit-mastery.ts): 0-100 mastery,
  // plus an explicit awakening flag that needs a breaking-point event, not
  // just a number — replaces the old "awakened at level 40" proxy.
  fruitMastery  Int     @default(0)
  fruitAwakened Boolean @default(false)

  // Multiplayer party presence — see Party below. null = not currently
  // sharing a live scene with crewmates. isSeparatedFromParty is an
  // explicit "I stepped away" flag so a character who's still physically
  // on the same island as their party doesn't get silently auto-rejoined.
  partyId              String?
  party                Party?  @relation(fields: [partyId], references: [id])
  isSeparatedFromParty Boolean @default(false)

  // Bounded, AI-maintained long-term memory — a compact prose digest the
  // narration/classification prompts feed back in, refreshed only on
  // significant beats (combat, mercy choice), never on every action. null =
  // no memorable events yet.
  memorySummary String?

  imprisonment     Imprisonment?
  pendingEncounter PendingEncounter?

  deathCause String?
  diedAt     DateTime?

  // Earned title (e.g. "Yonko de Isla Cementerio") from holding a territory — shown next to the faction rank.
  title String?
  // Set on first arrival at Laugh Tale: has seen what the One Piece really is (game/endgame-lore.ts). Required to join the final raid.
  knowsTruth Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Crews ----------

model Crew {
  id          String      @id @default(cuid())
  name        String      @unique
  flagDesc    String // freeform description of the jolly roger
  totalBounty Int         @default(0)
  reputation  Int         @default(0)
  shipName    String      @default("Barca sin nombre")
  captainId   String // the founding character's id — not FK-enforced, resolved in app code
  inviteCode  String      @unique @default(cuid())
  members     Character[]
  createdAt   DateTime    @default(now())
}

// ---------- Live multiplayer party scenes (crewmates physically together) ----------

// A crew's currently-together members share one live scene with a turn
// order (narrator always responds first, then whichever human's turnIndex
// it is). Lazily created/dissolved by src/lib/game/party.ts's
// syncPartyForCharacter, the same request-driven style WorldClock/
// tickWorldIfDue already uses — no cron/background job. One active party
// per crew at a time (crewId is unique): if a crew's members split across
// islands or drop below two together, the party is deleted, not archived.
model Party {
  id               String              @id @default(cuid())
  crewId           String              @unique // not FK-enforced, same convention as Crew.captainId
  turnOrder        String // JSON array of characterIds, captain first
  turnIndex        Int                 @default(0)
  memorySummary    String? // silent compaction of older shared-scene messages (game/scene-compaction.ts)
  compactedUntil   DateTime?
  awaitingNarrator Boolean             @default(false) // true right after a human posts, until the AI reply lands — locks out other submits meanwhile; false on creation, since nobody has spoken yet and it's simply turnIndex 0's turn
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  members          Character[]
  messages         PartySceneMessage[]
}

// The shared transcript for a Party — every member's free-text turn and
// every narrator reply, in order. Distinct from SceneMessage (which stays
// the per-character solo transcript, used whenever a character isn't
// currently in a party, and for echoing personal combat outcomes into the
// party feed as one-liners).
model PartySceneMessage {
  id                String   @id @default(cuid())
  partyId           String
  party             Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  authorCharacterId String? // null = the AI narrator
  authorName        String // denormalized at write time (character name, or "Narrador")
  text              String
  createdAt         DateTime @default(now())
}

// ---------- Devil Fruits ----------

enum FruitType {
  PARAMECIA
  ZOAN
  ZOAN_ANCIENT
  ZOAN_MYTHICAL
  LOGIA
}

enum Rarity {
  COMMON // low-tier Paramecia, minor utility
  UNCOMMON
  RARE
  EPIC // most Zoans, strong Paramecia
  LEGENDARY // Logia, Mythical/Ancient Zoan
  MYTHICAL_TIER // Yonko-caliber fruits (Gura Gura, Yami Yami, Hito Hito no Mi Nika, etc.)
}

model DevilFruit {
  id                  String      @id @default(cuid())
  // NOT @unique: a common (non-singleton) fruit gets a fresh row created
  // per grant, exactly like Weapon.name — see src/lib/game/devil-fruit-catalog.ts.
  // The catalog's `name` still only ever has ONE row when isSingleton is
  // true, because only the seed's upsert ever creates one.
  name                String // Japanese canon name, e.g. "Gomu Gomu no Mi"
  englishName         String
  type                FruitType
  rarity              Rarity
  description         String
  // Combat modifiers applied by the engine, kept as a JSON string so fruit
  // design stays data-driven instead of hardcoded per-fruit branches.
  effectsJson         String
  awakenable          Boolean     @default(true)
  claimedBy           Character?
  // true = one of the "main" canon fruits (Yami Yami, Magu Magu, a named
  // WorldActor's signature fruit, ...): never enters tryDropFruit's random
  // pool, only ever exists as the single seeded row, and stays permanently
  // linked to its canon WorldActor until a future kill-mechanic (not built
  // yet) reassigns it to a player. Everything else is duplicable.
  isSingleton         Boolean     @default(false)
  claimedByWorldActor WorldActor? @relation("WorldActorFruit")
  createdAt           DateTime    @default(now())
}

// ---------- Crew-vs-crew group battles (N-vs-N, individually chosen matchups) ----------

enum BattleStatus {
  PROPOSED // challenger set the matchups; waiting on the defending captain
  RESOLVED
  DECLINED
}

model GroupBattle {
  id           String                   @id @default(cuid())
  islandId     String
  island       Island                   @relation(fields: [islandId], references: [id])
  crewAId      String // challenger
  crewBId      String // defender
  status       BattleStatus             @default(PROPOSED)
  matchupsJson String // [{ aId, bId }] — each a named 1-vs-1 the challenger proposed
  resultJson   String? // GroupBattleResult, set once RESOLVED
  createdAt    DateTime                 @default(now())
  resolvedAt   DateTime?
  participants GroupBattleParticipant[]
}

model GroupBattleParticipant {
  id          String      @id @default(cuid())
  battleId    String
  battle      GroupBattle @relation(fields: [battleId], references: [id])
  characterId String
  character   Character   @relation(fields: [characterId], references: [id])
  side        String // "A" | "B"
  outcome     String? // "victory" | "defeat" | "draw", set once resolved
  died        Boolean     @default(false)

  @@unique([battleId, characterId])
}

// ---------- A combat encounter awaiting the player's fight-or-flee call ----------

model PendingEncounter {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id])
  enemyJson   String // { name, hp, atk, def, spd, isBoss } — hp here is the enemy's MAX hp, never mutated
  rewardsJson String // { berries, xp, bounty, hpLoss, islandDanger, isBoss }
  narrative   String
  assessment  String // "weaker" | "even" | "superior" — a read from Observation Haki + level gap, not a guarantee
  phase       String    @default("threat") // "threat" (fight-or-flee pending) | "fighting" (round-by-round exchanges) | "victory" (mercy choice pending)
  enemyHp     Int? // live remaining HP once fighting has started; null before the first exchange
  roundNumber Int       @default(0) // how many exchanges have happened so far, for the same MAX_ROUNDS cutoff runCombat used
  createdAt   DateTime  @default(now())
}

// ---------- 1-vs-1 player duels ----------

// Both fighters submit a move each round; the engine resolves both at once
// and the AI only narrates the result. Non-lethal by design: duel HP is a
// copy of maxHp, Character.hp is never touched, and the loser is simply
// "knocked out" — no permadeath. characterId columns are plain strings, not
// FKs (same convention as Crew.captainId / Grudge).
enum DuelStatus {
  PROPOSED
  ACTIVE
  FINISHED
  DECLINED
  CANCELLED
}

model Duel {
  id                  String        @id @default(cuid())
  islandId            String
  challengerId        String
  opponentId          String
  status              DuelStatus    @default(PROPOSED)
  round               Int           @default(0)
  challengerHp        Int
  opponentHp          Int
  challengerMaxHp     Int
  opponentMaxHp       Int
  challengerAction    String?
  challengerTactic    Int           @default(0)
  challengerTechnique String        @default("none")
  opponentAction      String?
  opponentTactic      Int           @default(0)
  opponentTechnique   String        @default("none")
  winnerId            String?
  // lethal: real permadeath rules (death roll / Marine capture), duel HP starts from
  // current HP. hostile: a non-consensual hunt between enemy factions — the target
  // may try to escape instead of accepting.
  lethal              Boolean       @default(false)
  hostile             Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  messages            DuelMessage[]
}

model DuelMessage {
  id                String   @id @default(cuid())
  duelId            String
  duel              Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)
  authorCharacterId String? // null = the narrator
  authorName        String
  text              String
  createdAt         DateTime @default(now())
}

// ---------- Joint fights: N allies (players + NPC companions) against one enemy ----------

// One shared fight where every participant acts in the same round: they each
// describe a move, the engine resolves all of them at once (engine/joint-fight.ts)
// and the AI narrates one coral scene. Also the backbone of Poneglyph guardians,
// territory conquest and the final raid — `kind` + `contextJson` say which.
// characterId columns are plain strings (same convention as Crew.captainId);
// NPC allies use an "npc:<companionId>" id and never need to submit a move.
model JointFight {
  id             String                  @id @default(cuid())
  islandId       String
  kind           String                  @default("party") // "party" | "poneglyph" | "conquest" | "raid"
  contextJson    String                  @default("{}")
  status         String                  @default("ACTIVE") // ACTIVE | WON | LOST
  round          Int                     @default(1)
  enemyJson      String // StoredEnemy, already scaled for the group at creation
  enemyHp        Int
  enemyMaxHp     Int
  rewardsJson    String
  stakes         String? // one line for the narrator: what the group is fighting for
  roundStartedAt DateTime                @default(now())
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  participants   JointFightParticipant[]
  messages       JointFightMessage[]
}

model JointFightParticipant {
  id          String     @id @default(cuid())
  fightId     String
  fight       JointFight @relation(fields: [fightId], references: [id], onDelete: Cascade)
  characterId String // real character id, or "npc:<companionId>"
  name        String
  isNpc       Boolean    @default(false)
  hp          Int
  maxHp       Int
  action      String? // free text submitted this round (null = hasn't moved yet)
  tactic      Int        @default(0)
  technique   String     @default("none")
  // Stats for an NPC ally that is not a personal companion (a pledged WorldActor in the final raid): JSON { atk, def, spd }.
  npcStatsJson String?
  status      String     @default("FIGHTING") // FIGHTING | DOWN | FLED
  joinedAt    DateTime   @default(now())

  @@index([characterId])
}

model JointFightMessage {
  id                String     @id @default(cuid())
  fightId           String
  fight             JointFight @relation(fields: [fightId], references: [id], onDelete: Cascade)
  authorCharacterId String? // null = the narrator
  authorName        String
  text              String
  createdAt         DateTime   @default(now())
}

// ---------- Capture & rescue ----------

model Imprisonment {
  id             String    @id @default(cuid())
  characterId    String    @unique
  character      Character @relation(fields: [characterId], references: [id])
  islandId       String // where they're held (an Impel-Down-style facility, a Marine base brig...)
  island         Island    @relation(fields: [islandId], references: [id])
  reason         String
  capturedAt     DateTime  @default(now())
  // A rescuer's effective combat power (see engine/character-stats) must clear
  // this bar to break the prisoner out — undergunned rescue attempts fail and
  // risk the rescuer getting captured too.
  minRescueLevel Int
  bailBerries    Int? // an alternative: buy your way out if you can afford it
  cellLevel      Int       @default(0) // 0 = ordinary brig; 1-6 = Impel Down level (engine/impel-down.ts)
  // Breaking out from the inside (engine/escape.ts): levels already climbed, how
  // alert the guards are after failed tries, and when the last attempt was.
  escapeProgress      Int       @default(0)
  alert               Int       @default(0)
  lastEscapeAttemptAt DateTime?
  rescuedById    String?
  releasedAt     DateTime?
}

// ---------- Recruitable crew NPCs (a lightweight companion, not a full account) ----------

model NPCCompanion {
  id          String          @id @default(cuid())
  characterId String
  character   Character       @relation(fields: [characterId], references: [id])
  name        String
  role        String // "Espadachín", "Cocinero", "Médico", "Navegante", "Francotirador", "Arqueóloga", "Carpintero", "Músico", ...
  hp          Int             @default(30)
  maxHp       Int             @default(30)
  loyalty     Int             @default(50) // 0-100, affects desertion/rescue behavior
  status      CharacterStatus @default(ALIVE)
  deathCause  String?
  joinedAt    DateTime        @default(now())
  diedAt      DateTime?
}

// ---------- Weapons & Equipment ----------

enum WeaponGrade {
  NONE // "wazamono"-tier, mass produced
  WAZAMONO
  RYO_WAZAMONO
  O_WAZAMONO
  SAIJO_O_WAZAMONO // 12 supreme grade blades, extremely rare
  UNIQUE // one-of-a-kind named artifacts outside the sword-grading system
}

model Weapon {
  id          String      @id @default(cuid())
  // Not @unique: common-grade starter/shop gear is instanced per character
  // (many "Espada de acero" can exist at once). Only named meito are
  // seeded as a single row, which keeps them 1-of-1 in practice since
  // nothing else ever creates a second row with that name.
  name        String
  kind        String // "Katana", "Nodachi", "Pistola", "Tonfa", "Hacha", ...
  grade       WeaponGrade @default(NONE)
  description String
  atkBonus    Int         @default(0)
  specialJson String? // special ability payload, engine-interpreted
  basePrice   Int         @default(500)

  ownerId    String?    @unique
  owner      Character? @relation("OwnedWeapons", fields: [ownerId], references: [id])
  equippedOn Character? @relation("EquippedWeapon")

  createdAt DateTime @default(now())
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  name        String
  kind        String // "Consumible", "Mapa", "Reliquia", "Log Pose", ...
  quantity    Int       @default(1)
  effectJson  String?
  createdAt   DateTime  @default(now())
}

// ---------- World: Islands, Seas, Poneglyphs ----------

enum Sea {
  EAST_BLUE
  WEST_BLUE
  NORTH_BLUE
  SOUTH_BLUE
  PARADISE
  NEW_WORLD
}

model Island {
  id              String     @id @default(cuid())
  name            String     @unique
  sea             Sea
  description     String
  arcHook         String? // the island's current conflict, told once on first arrival — separate from the ambient `description` shown every visit
  dangerLevel     Int        @default(1) // 1-10, gates which events/enemies can roll
  minLevelToEnter Int        @default(1) // travel to this island is refused below this level — the Grand Line doesn't ease you in
  factionControl  String? // "Marina", "Yonko Kaido", "Sin gobierno", ...
  // tidal: the island only surfaces in alternating tide windows (engine/travel.ts). requiresRoadPoneglyphs:
  // the way is only known to someone who has read all four Road Poneglyphs (Laugh Tale).
  tidal                 Boolean    @default(false)
  requiresRoadPoneglyphs Boolean   @default(false)
  hasPoneglyph    Boolean    @default(false)
  poneglyphId     String?    @unique
  poneglyph       Poneglyph? @relation(fields: [poneglyphId], references: [id])

  connections String // JSON string array of reachable Island ids (adjacency)

  charactersHere Character[]
  eventTemplates EventTemplate[]
  prisoners      Imprisonment[]
  groupBattles   GroupBattle[]
}

model Poneglyph {
  id        String  @id @default(cuid())
  codeName  String  @unique // "Poneglyph de Zou", etc.
  kind      String // "Road", "Historia", "Corazón"
  loreText  String
  guardedBy String? // description of the guardian encounter
  island    Island?
}

// ---------- Events (the random engine's content pool) ----------

enum EventKind {
  EXPLORATION
  COMBAT
  TREASURE
  SOCIAL
  DEVIL_FRUIT
  BOSS
  TRAINING
  RUMOR
}

model EventTemplate {
  id         String    @id @default(cuid())
  islandId   String?
  island     Island?   @relation(fields: [islandId], references: [id])
  kind       EventKind
  minDanger  Int       @default(1)
  maxDanger  Int       @default(10)
  weight     Int       @default(10) // relative pick chance
  title      String
  bodyJson   String // narrative variants + outcome table, engine-interpreted
  repeatable Boolean   @default(true)
}

// ---------- Logs & the living world ----------

model GameLogEntry {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  text        String
  kind        String // "explore" | "combat" | "reward" | "death" | ...
  createdAt   DateTime  @default(now())
}

model BountyLogEntry {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  delta       Int
  reason      String
  createdAt   DateTime  @default(now())
}

// The full back-and-forth roleplay transcript for a character — every free-text
// line the player sent and every AI narration reply, in order. Distinct from
// GameLogEntry (the terse mechanical Bitácora ticker: "explored, +150 berries")
// so a long freeform scene doesn't have to fight for space with that summary
// view. Also the source of narration prompts' short-term memory — richer than
// GameLogEntry since it includes pure-roleplay turns that never touch a stat.
model SceneMessage {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  role        String // "player" | "narrator"
  text        String
  createdAt   DateTime  @default(now())
}

// Global news feed — every player reads the same world.
model NewsItem {
  id           String   @id @default(cuid())
  headline     String
  body         String
  category     String // "Recompensas" | "Frutas" | "Poneglifos" | "Tripulaciones" | "Guerra" | "Muertes" | "Gobierno Mundial"
  // when a headline is about a player, link it so profiles can show "apareciste en las noticias"
  characterId  String?
  worldActorId String?
  // "normal" | "digest" | "major" — drives headline treatment in the news
  // UI. Set explicitly at every postNews/newsItem.create call site: player
  // death/capture/poneglyph-reads/group-battle outcomes are "major", the
  // periodic bounty roundup is "digest", everything else stays "normal".
  severity     String   @default("normal")
  createdAt    DateTime @default(now())
}

// ---------- The world simulates itself: factions act independently ----------

enum ActorRole {
  YONKO
  ADMIRAL
  WARLORD // Shichibukai-equivalent
  REVOLUTIONARY_COMMANDER
  MARINE_GENERAL
  CIPHER_POL
  GOROSEI // the Five Elders: the Government's highest visible power
  HIDDEN_RULER // the one nobody names: the true power behind the Gorosei
  NOTABLE_PIRATE // a significant independent captain/crewmate, not yet Yonko/Warlord tier — rankLabel carries the specific title
}

// The behavioral bucket world-news templates gate actor selection on — see
// WorldEventTemplate.allowedFactionTypes and src/lib/engine/world.ts. Not
// the same enum as Character's `Faction` (that one only covers what a
// PLAYER can pick at creation); this one also needs CIPHER_POL/CIVILIAN/
// UNAFFILIATED to cover the full canon cast.
enum FactionType {
  PIRATE
  MARINE
  REVOLUTIONARY
  CIPHER_POL
  BOUNTY_HUNTER // e.g. Cross Guild — hunts pirates for reward, not government-aligned
  CIVILIAN
  UNAFFILIATED
}

model WorldActor {
  id           String    @id @default(cuid())
  name         String    @unique
  role         ActorRole
  powerLevel   Int       @default(90) // 1-100, gates which world events they can trigger/resolve
  description  String
  // "Desplegado sosteniendo la línea en Wano", null cuando está libre
  currentFocus String?
  busyUntil    DateTime?
  homeIslandId String?
  // Short in-character voice line, fed to combat narration — same shape as
  // EnemySpec.personality, just persistent across encounters instead of
  // one-shot. See Grudge below for the per-character memory this enables.
  personality  String?

  // Faction-aware world news (2026-09-23 follow-up): factionType is what
  // WorldEventTemplate.allowedFactionTypes gates on; factionName is the
  // specific display label ("Marina", "Piratas de Barbanegra", "Cross
  // Guild"). rankLabel overrides `role`'s coarser enum for display/news
  // when needed (e.g. role: MARINE_GENERAL, rankLabel: "Almirante de
  // Flota (retirado)"). canonBounty is the TRUE canon berries figure —
  // BigInt because real canon numbers (e.g. Shanks' 4,048,900,000)
  // overflow Character.bounty's Int32. canonWeapon is flavor/display text
  // only — WorldActors never fight directly today. devilFruitId links a
  // canon signature fruit (only ever set on an isSingleton DevilFruit row).
  factionType  FactionType @default(UNAFFILIATED)
  factionName  String      @default("Desconocida")
  rankLabel    String?
  canonBounty  BigInt?
  canonWeapon  String?
  devilFruitId String?     @unique
  devilFruit   DevilFruit? @relation("WorldActorFruit", fields: [devilFruitId], references: [id])

  createdAt DateTime @default(now())
}

// Per-(WorldActor, Character) persistent memory — same spike/decay/capped-
// probability shape pursuit.ts already proved out for poneglyphHeat, just
// scoped to one specific NPC-character pair instead of one global "how
// hunted are you." worldActorId/characterId are plain strings, not FK-
// enforced, matching the existing Crew.captainId/GroupBattle.crewAId
// convention above — avoids relation-ambiguity headaches on two models that
// already have many other relations. See src/lib/engine/grudge.ts and
// src/lib/game/grudges.ts.
model Grudge {
  id                String   @id @default(cuid())
  worldActorId      String
  characterId       String
  heat              Int      @default(0)
  lastIncidentAt    DateTime @default(now())
  lastIncidentNote  String // short past-tense line narration can reference, e.g. "escapó de él en Isla Cementerio"
  enemyName         String // denormalized snapshot of the subordinate fought, so a future ambush can reuse it without re-deriving from seed data
  enemySnapshotJson String // { hp, atk, def, spd } at the time of the incident — replayed as-is for a future ambush
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([worldActorId, characterId])
}

// A thread left by sparing or finishing a named enemy: it resurfaces later (boon, betrayal,
// avenger or tribute) up to 3 stages, each return being a new choice. See engine/consequence.ts.
model Consequence {
  id          String    @id @default(cuid())
  characterId String
  kind        String // "spared" | "killed"
  enemyName   String
  worldActorId String?
  islandId    String
  islandName  String
  stage       Int       @default(1)
  dueAt       DateTime
  resolvedAt  DateTime?
  outcome     String?
  createdAt   DateTime  @default(now())

  @@index([characterId, resolvedAt])
}

// A concrete goal an island hands one character, scaled to their level (engine/missions.ts).
model Mission {
  id            String    @id @default(cuid())
  characterId   String
  islandId      String
  kind          String // explore | win_fights | train | spare | travel
  title         String
  brief         String
  target        Int
  progress      Int       @default(0)
  tier          Int       @default(1)
  berries       Int       @default(0)
  xp            Int       @default(0)
  destination   String?
  isArc         Boolean   @default(false)
  patronActorId String?
  status        String    @default("ACTIVE") // ACTIVE | DONE
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([characterId, islandId, status])
}

// Marks that a character has already been given the AI's full panorama of an island.
model IslandBriefing {
  id          String   @id @default(cuid())
  characterId String
  islandId    String
  text        String   @default("") // empty until the AI (or its static fallback) has produced the panorama
  createdAt   DateTime @default(now())

  @@unique([characterId, islandId])
}

model WorldEventTemplate {
  id                  String  @id @default(cuid())
  weight              Int     @default(10)
  minHeat             Int     @default(0) // world "heat" gates escalating events (0 = calm era, 100 = final saga chaos)
  headline            String // may contain {actor} placeholder
  bodyJson            String // narrative variants + side effects, engine-interpreted
  category            String
  repeatable          Boolean @default(true)
  // JSON array of FactionType values gating which WorldActor can star in
  // this template (see src/lib/engine/world.ts's runWorldTick) — null means
  // no specific actor is needed (a bare Gobierno Mundial announcement).
  // Fixes the original bug this whole pass started from: an Admiral being
  // picked for a "recluta nuevos aliados" pirate-flavored headline.
  allowedFactionTypes String?
  // Short instruction fed to the AI narrator (e.g. "a pirate crew raids a
  // rival's territory") — the actual headline/body prose is generated per
  // firing now, not picked from bodyJson's old hand-written variants; those
  // variants are kept only as the offline fallback if the AI call fails.
  promptHint          String  @default("")
}

// Tracks the single global simulation clock so the tick only ever runs once per interval.
model WorldClock {
  id           Int       @id @default(1)
  heat         Int       @default(10) // escalates over time / with big player feats
  lastTickAt   DateTime  @default(now())
  // Separate, much rarer cadence for the periodic canon-bounty roundup
  // (tickBountyDigestIfDue in world-tick.ts) — null means it has never run.
  lastDigestAt DateTime?
  // The world's current age. Flips to "Nueva Era" when a final raid topples the hidden ruler (game/raid.ts).
  era          String    @default("Era del Olvido")
}

// Durable record of unexpected server-side errors — survives restarts and
// deploys (unlike console output), so "did something break, and when" is
// always answerable by querying the database instead of hoping a log line
// scrolled by in a terminal that's long gone.
model ErrorLog {
  id        String   @id @default(cuid())
  context   String // e.g. "api/characters/[id]/actions"
  message   String
  stack     String?
  metaJson  String?
  createdAt DateTime @default(now())
}

// ---------- Territory conquest ("become the new Yonko") ----------

// One row per conquerable island. Held by a canon power (ownerActorId) until
// players break its army, its commanders and then the holder in person (three
// joint fights, game/territory.ts); the contributors then VOTE who among them
// keeps the island — a real in-fiction dispute, weighted by what each gave.
// The winner gets a title, income and a garrison that decays: neglect it and
// the old power takes the island back. String ids are plain (no FKs), same
// convention as Crew.captainId.
model Territory {
  id                   String    @id @default(cuid())
  islandId             String    @unique
  homeActorId          String? // the canon power that holds it by default and retakes it if the garrison falls
  ownerActorId         String? // current canon holder (null once players hold it)
  ownerCharacterId     String? // player claimant — "the new Yonko"
  ownerCrewId          String?
  ownerName            String
  title                String    @default("Señor de la isla")
  status               String    @default("HELD") // HELD | CONQUEST | CLAIM_VOTE
  stage                String    @default("ARMY") // ARMY -> COMMANDERS -> HOLDER (only meaningful in CONQUEST)
  garrison             Int       @default(100)
  lastPressureAt       DateTime  @default(now())
  lastIncomeAt         DateTime  @default(now())
  lastActivityAt       DateTime  @default(now())
  contributionsJson    String    @default("{}") // characterId -> points earned this conquest
  finalBlowCharacterId String?
  voteDeadline         DateTime?
  votesJson            String    @default("{}") // voterId -> candidateId
  musterJson           String    @default("[]") // characterIds signed up for the assault
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ---------- Buster Call: the Government's siege of an island ----------

// A timed siege: three waves of warships that defenders (players on the island)
// must break with joint fights before endsAt. If they don't, the island is
// bombarded — everyone still present takes a brutal hit with a real death roll.
// Triggered by deep Impel Down breakouts and by taking a Government stronghold.
model BusterCall {
  id          String   @id @default(cuid())
  islandId    String
  reason      String
  status      String   @default("ACTIVE") // ACTIVE | REPELLED | FALLEN
  wave        Int      @default(1) // the wave currently coming (1-3)
  wavesBroken Int      @default(0)
  musterJson  String   @default("[]")
  startedAt   DateTime @default(now())
  endsAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([islandId, status])
}

// ---------- The final raid: toppling the hidden ruler ----------

// One world-wide raid at a time. A coalition of players who have seen Laugh Tale
// (plus pledged NPC allies) storms Mary Geoise through four joint fights; the
// survivors then vote who is crowned Pirate King (weighted by contribution).
// characterId strings are plain (no FKs), same convention as Territory/Crew.
model Raid {
  id                   String    @id @default(cuid())
  status               String    @default("MUSTERING") // MUSTERING | ACTIVE | CLAIM_VOTE | WON | LOST | CANCELLED
  phase                Int       @default(1) // 1 Guardia de Pangea, 2 Gorosei, 3 Almirantes, 4 Rey Sin Nombre
  leaderId             String
  musterJson           String    @default("[]")
  alliesJson           String    @default("[]") // pledged WorldActor ids
  contributionsJson    String    @default("{}")
  finalBlowCharacterId String?
  votesJson            String    @default("{}")
  voteDeadline         DateTime?
  lastActivityAt       DateTime  @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// How much a WorldActor trusts one character (0-100): raised by missions done in
// their name and by sparing their people; enough of it lets that actor be pledged
// as an NPC ally of the final raid.
model Alliance {
  id           String   @id @default(cuid())
  worldActorId String
  characterId  String
  standing     Int      @default(0)
  lastNote     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([worldActorId, characterId])
}
